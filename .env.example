# Akash Hermes Client Configuration
# Copy this file to .env and fill in the required values

# ===================
# Required Settings
# ===================

# Akash RPC endpoint
HC_RPC_ENDPOINT=https://rpc.akashnet.net:443

# Pyth contract address on Akash
HC_CONTRACT_ADDRESS=akash1...

# Pyth API key used for price updates and router-set upgrade VAAs
HC_HERMES_API_KEY=your_pyth_api_key

# Wallet mnemonic for signing transactions (12 or 24 words)
# WARNING: Keep this secure! Never commit to version control.
HC_WALLET_SECRET="mnemonic:your twelve or twenty four word mnemonic phrase here"

# ===================
# Optional Settings
# ===================

# Pyth Hermes API endpoint (default: https://pyth.dourolabs.app/hermes)
# Price updates use /v2/updates/price/latest.
# Router rotations use /v1/guardian_set_upgrade_vaa on the same base URL.
# HC_HERMES_ENDPOINT=https://pyth.dourolabs.app/hermes

# Price deviation tolerance, default=0 (e.g., "100" or "5%")
# HC_PRICE_DEVIATION_TOLERANCE=0

# Price update interval in milliseconds (default: 300000 = 5 minutes)
# HC_UPDATE_INTERVAL_MS=300000

# Gas price for transactions (default: 0.025uakt)
# HC_GAS_PRICE=0.025uakt

# Token denomination (default: uakt)
# HC_DENOM=uakt

# Healthcheck server port (default: 3000)
# HC_HEALTHCHECK_PORT=3000
